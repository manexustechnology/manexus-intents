# Copy to .env. Frontend dev server
PORT=24010
ALLOWED_HOSTS=

# Backend (Cloudflare Pages Functions). Never prefix with VITE_.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# 1Click partner key from https://partners.near-intents.org (optional; without it 1Click adds 25 bps).
ONECLICK_API_KEY=
ONECLICK_BASE_URL=https://1click.chaindefuser.com
NEAR_RPC_URL=https://rpc.mainnet.fastnear.com

# NEAR AI Cloud (drafts policy JSON and summaries only). Key stays server-side.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=openai/gpt-6-luna
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
