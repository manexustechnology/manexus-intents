{
  "name": "manexus-intents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions",
    "test": "node --test 'tests/**/*.test.ts'",
    "test:e2e": "playwright test",
    "dev:api": "wrangler pages dev --d1=DB --port 24011 --proxy 24010",
    "db:migrate:local": "wrangler d1 migrations apply manexus-intents --local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@playwright/test": "^1.64.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "wrangler": "^4.155.0"
  },
  "dependencies": {
    "viem": "^2.57.7"
  }
}
